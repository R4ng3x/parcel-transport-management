    <record id="view_ptm_route_correction_list" model="ir.ui.view">
        <field name="name">parcel.route.correction.list</field>
        <field name="model">parcel.route.correction</field>
        <field name="arch" type="xml">
            <list
                class="o_ptm_native_view o_ptm_history_view"
                string="Route Corrections"
                create="false"
                edit="false"
                delete="false"
                default_order="changed_at desc, id desc"
                decoration-info="applied"
                decoration-muted="not applied"
            >
                <field name="changed_at" />
                <field name="shipment_id" />
                <field name="applied" />
                <field name="previous_origin_zone_id" optional="show" />
                <field name="new_origin_zone_id" optional="show" />
                <field name="previous_destination_zone_id" optional="show" />
                <field name="new_destination_zone_id" optional="show" />
                <field name="changed_by_id" />
                <field name="reason" optional="show" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_ptm_route_correction_form" model="ir.ui.view">
        <field name="name">parcel.route.correction.form</field>
        <field name="model">parcel.route.correction</field>
        <field name="arch" type="xml">
            <form
                class="o_ptm_native_view o_ptm_history_view"
                string="Route Correction"
                create="false"
                edit="false"
                delete="false"
                duplicate="false"
            >
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="AUDIT ONLY"
                        bg_color="text-bg-secondary"
                        invisible="applied"
                    />
                    <div class="oe_title">
                        <span class="o_ptm_eyebrow">Append-only route record</span>
                        <label for="shipment_id" />
                        <h1>
                            <field name="shipment_id" readonly="1" />
                        </h1>
                        <h2>
                            <field name="changed_at" readonly="1" />
                        </h2>
                    </div>
                    <group>
                        <group string="Pickup Zone">
                            <field name="previous_origin_zone_id" readonly="1" />
                            <field name="new_origin_zone_id" readonly="1" />
                        </group>
                        <group string="Delivery Zone">
                            <field name="previous_destination_zone_id" readonly="1" />
                            <field name="new_destination_zone_id" readonly="1" />
                        </group>
                    </group>
                    <group>
                        <group string="Audit">
                            <field name="applied" readonly="1" />
                            <field name="changed_by_id" readonly="1" />
                            <field name="changed_at" readonly="1" />
                            <field
                                name="company_id"
                                readonly="1"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group string="Reason">
                            <field name="reason" nolabel="1" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Previous Snapshot" name="previous_snapshot">
                            <field name="previous_values" nolabel="1" readonly="1" />
                        </page>
                        <page string="Corrected Snapshot" name="corrected_snapshot">
                            <field name="new_values" nolabel="1" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ptm_route_correction_search" model="ir.ui.view">
        <field name="name">parcel.route.correction.search</field>
        <field name="model">parcel.route.correction</field>
        <field name="arch" type="xml">
            <search string="Search Route Corrections">
                <field name="shipment_id" />
                <field name="changed_by_id" />
                <filter name="applied" string="Applied" domain="[('applied', '=', True)]" />
                <filter name="audit_only" string="Audit Only" domain="[('applied', '=', False)]" />
                <filter name="changed_at" string="Correction Date" date="changed_at" />
                <group name="group_by">
                    <filter
                        name="group_shipment"
                        string="Shipment"
                        context="{'group_by': 'shipment_id'}"
                    />
                    <filter
                        name="group_applied"
                        string="Applied"
                        context="{'group_by': 'applied'}"
                    />
                    <filter
                        name="group_changed_by"
                        string="Changed By"
                        context="{'group_by': 'changed_by_id'}"
                    />
                    <filter
                        name="group_day"
                        string="Day"
                        context="{'group_by': 'changed_at:day'}"
                    />
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_ptm_route_history" model="ir.actions.act_window">
        <field name="name">Route Corrections</field>
        <field name="res_model">parcel.route.correction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ptm_route_correction_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No route corrections recorded</p>
            <p
            >Every route snapshot correction is preserved, including audit-only changes to terminal shipments.</p>
        </field>
    </record>

