<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ptm_pickup_event_list" model="ir.ui.view">
        <field name="name">parcel.pickup.event.list</field>
        <field name="model">parcel.pickup.event</field>
        <field name="arch" type="xml">
            <list
                class="o_ptm_native_view o_ptm_history_view"
                string="Pickup Events"
                create="false"
                edit="false"
                delete="false"
                default_order="occurred_at desc, id desc"
            >
                <field name="occurred_at" />
                <field name="shipment_id" />
                <field name="courier_id" />
                <field name="confirmed_by_id" />
                <field name="package_ids" widget="many2many_tags" optional="show" />
                <field name="note" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_ptm_pickup_event_form" model="ir.ui.view">
        <field name="name">parcel.pickup.event.form</field>
        <field name="model">parcel.pickup.event</field>
        <field name="arch" type="xml">
            <form
                class="o_ptm_native_view o_ptm_history_view"
                string="Pickup Event"
                create="false"
                edit="false"
                delete="false"
                duplicate="false"
            >
                <sheet>
                    <div class="oe_title">
                        <span class="o_ptm_eyebrow">Append-only pickup record</span>
                        <label for="shipment_id" />
                        <h1>
                            <field name="shipment_id" readonly="1" />
                        </h1>
                        <h2>
                            <field name="occurred_at" readonly="1" />
                        </h2>
                    </div>
                    <group>
                        <group string="Custody">
                            <field name="courier_id" readonly="1" />
                            <field name="confirmed_by_id" readonly="1" />
                            <field
                                name="company_id"
                                readonly="1"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group string="Record">
                            <field name="occurred_at" readonly="1" />
                            <field name="note" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Packages" name="packages">
                            <field name="package_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="tracking_code" />
                                    <field name="weight" />
                                    <field name="weight_uom_id" />
                                    <field name="delivery_event_id" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ptm_pickup_event_search" model="ir.ui.view">
        <field name="name">parcel.pickup.event.search</field>
        <field name="model">parcel.pickup.event</field>
        <field name="arch" type="xml">
            <search string="Search Pickup Events">
                <field name="shipment_id" />
                <field name="courier_id" />
                <field name="confirmed_by_id" />
                <filter name="occurred_at" string="Pickup Date" date="occurred_at" />
                <filter name="with_note" string="With Note" domain="[('note', '!=', False)]" />
                <group name="group_by">
                    <filter
                        name="group_shipment"
                        string="Shipment"
                        context="{'group_by': 'shipment_id'}"
                    />
                    <filter
                        name="group_courier"
                        string="Courier"
                        context="{'group_by': 'courier_id'}"
                    />
                    <filter
                        name="group_confirmed_by"
                        string="Confirmed By"
                        context="{'group_by': 'confirmed_by_id'}"
                    />
                    <filter
                        name="group_day"
                        string="Day"
                        context="{'group_by': 'occurred_at:day'}"
                    />
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_ptm_pickup_history" model="ir.actions.act_window">
        <field name="name">Pickup Events</field>
        <field name="res_model">parcel.pickup.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ptm_pickup_event_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pickup events recorded</p>
            <p>Pickup confirmations appear here after they are recorded from a shipment.</p>
        </field>
    </record>

