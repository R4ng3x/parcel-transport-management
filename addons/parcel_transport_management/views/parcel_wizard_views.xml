<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ptm_assignment_wizard_form" model="ir.ui.view">
        <field name="name">parcel.assignment.wizard.form</field>
        <field name="model">parcel.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Courier" class="o_ptm_wizard">
                <group>
                    <field name="company_id" invisible="1" />
                    <field name="shipment_state" invisible="1" />
                    <field name="shipment_id" />
                    <field name="current_courier_id" invisible="shipment_state == 'draft'" />
                    <field
                        name="courier_id"
                        domain="[('company_id', '=', company_id), ('availability', '=', 'available'), ('id', '!=', current_courier_id)]"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field
                        name="reason"
                        invisible="shipment_state in ['draft', 'assigned']"
                        required="shipment_state not in ['draft', 'assigned']"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm Assignment"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Discard" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ptm_assignment_wizard" model="ir.actions.act_window">
        <field name="name">Assign or Reassign Courier</field>
        <field name="res_model">parcel.assignment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ptm_assignment_wizard_form" />
        <field name="target">new</field>
    </record>

    <record id="view_ptm_pickup_wizard_form" model="ir.ui.view">
        <field name="name">parcel.pickup.wizard.form</field>
        <field name="model">parcel.pickup.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Pickup" class="o_ptm_wizard">
                <group>
                    <field name="company_id" invisible="1" />
                    <field name="shipment_id" />
                    <field
                        name="package_ids"
                        widget="many2many_tags"
                        domain="[('shipment_id', '=', shipment_id), ('company_id', '=', company_id), ('pickup_event_id', '=', False)]"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="note" placeholder="Optional operational note" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Record Pickup"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Discard" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ptm_pickup_wizard" model="ir.actions.act_window">
        <field name="name">Record Pickup</field>
        <field name="res_model">parcel.pickup.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ptm_pickup_wizard_form" />
        <field name="target">new</field>
    </record>

    <record id="view_ptm_delivery_wizard_form" model="ir.ui.view">
        <field name="name">parcel.delivery.wizard.form</field>
        <field name="model">parcel.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Delivery" class="o_ptm_wizard">
                <group>
                    <field name="company_id" invisible="1" />
                    <field name="shipment_id" />
                    <field
                        name="package_ids"
                        widget="many2many_tags"
                        domain="[('shipment_id', '=', shipment_id), ('company_id', '=', company_id), ('pickup_event_id', '!=', False), ('delivery_event_id', '=', False)]"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="recipient_name" />
                    <field name="note" placeholder="Optional delivery note" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Record Delivery"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Discard" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ptm_delivery_wizard" model="ir.actions.act_window">
        <field name="name">Record Delivery</field>
        <field name="res_model">parcel.delivery.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ptm_delivery_wizard_form" />
        <field name="target">new</field>
    </record>

    <record id="view_ptm_cancel_wizard_form" model="ir.ui.view">
        <field name="name">parcel.cancel.wizard.form</field>
        <field name="model">parcel.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Shipment" class="o_ptm_wizard">
                <group>
                    <field name="company_id" invisible="1" />
                    <field name="shipment_id" />
                    <field
                        name="reason"
                        placeholder="Explain why this shipment must be cancelled"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Cancel Shipment"
                        type="object"
                        class="btn-danger"
                    />
                    <button string="Keep Shipment" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ptm_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Shipment</field>
        <field name="res_model">parcel.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ptm_cancel_wizard_form" />
        <field name="target">new</field>
    </record>

    <record id="view_ptm_sla_wizard_form" model="ir.ui.view">
        <field name="name">parcel.sla.wizard.form</field>
        <field name="model">parcel.sla.wizard</field>
        <field name="arch" type="xml">
            <form string="Revise SLA" class="o_ptm_wizard">
                <group>
                    <field name="company_id" invisible="1" />
                    <field name="shipment_id" />
                    <field name="expected_delivery_at" />
                    <field name="reason" placeholder="Explain the deadline revision" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Revise SLA"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Discard" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ptm_sla_wizard" model="ir.actions.act_window">
        <field name="name">Revise SLA</field>
        <field name="res_model">parcel.sla.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ptm_sla_wizard_form" />
        <field name="target">new</field>
    </record>

    <record id="view_ptm_route_wizard_form" model="ir.ui.view">
        <field name="name">parcel.route.wizard.form</field>
        <field name="model">parcel.route.wizard</field>
        <field name="arch" type="xml">
            <form string="Correct Route" class="o_ptm_wizard">
                <field name="company_id" invisible="1" />
                <field name="shipment_state" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="shipment_state not in ['delivered', 'cancelled']"
                >
                    This shipment is terminal. Changes will be recorded for audit only;
                    the route snapshot will not change.
                </div>
                <group>
                    <group string="Pickup">
                        <field name="pickup_name" />
                        <field name="pickup_street" />
                        <field name="pickup_street2" />
                        <field name="pickup_city" />
                        <field name="pickup_zip" />
                        <field
                            name="pickup_country_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                    </group>
                    <group string="Delivery">
                        <field name="delivery_name" />
                        <field name="delivery_street" />
                        <field name="delivery_street2" />
                        <field name="delivery_city" />
                        <field name="delivery_zip" />
                        <field
                            name="delivery_country_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                    </group>
                </group>
                <group>
                    <field name="shipment_id" />
                    <field name="reason" placeholder="Explain the route correction" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Update Route Snapshot"
                        type="object"
                        class="btn-primary"
                        invisible="shipment_state in ['delivered', 'cancelled']"
                    />
                    <button
                        name="action_confirm"
                        string="Record Audit Annotation"
                        type="object"
                        class="btn-primary"
                        invisible="shipment_state not in ['delivered', 'cancelled']"
                    />
                    <button string="Discard" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ptm_route_wizard" model="ir.actions.act_window">
        <field name="name">Correct Route</field>
        <field name="res_model">parcel.route.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ptm_route_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
