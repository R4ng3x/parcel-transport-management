<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_parcel_transport" model="ir.module.category">
        <field name="name">Parcel Transport</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_parcel_transport" model="res.groups.privilege">
        <field name="name">Parcel Transport</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="module_category_parcel_transport" />
    </record>

    <record id="group_ptm_courier" model="res.groups">
        <field name="name">Courier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_parcel_transport" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_ptm_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_parcel_transport" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_ptm_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_parcel_transport" />
        <field name="implied_ids" eval="[(4, ref('group_ptm_operator'))]" />
    </record>

    <data noupdate="1">
        <record id="rule_ptm_shipment_company" model="ir.rule">
            <field name="name">Parcel shipments by allowed company</field>
            <field name="model_id" ref="model_parcel_shipment" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_package_company" model="ir.rule">
            <field name="name">Parcel packages by allowed company</field>
            <field name="model_id" ref="model_parcel_package" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_pickup_event_company" model="ir.rule">
            <field name="name">Parcel pickup events by allowed company</field>
            <field name="model_id" ref="model_parcel_pickup_event" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_delivery_event_company" model="ir.rule">
            <field name="name">Parcel delivery events by allowed company</field>
            <field name="model_id" ref="model_parcel_delivery_event" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_delivery_attempt_company" model="ir.rule">
            <field name="name">Parcel delivery attempts by allowed company</field>
            <field name="model_id" ref="model_parcel_delivery_attempt" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_delivery_retry_company" model="ir.rule">
            <field name="name">Parcel delivery retries by allowed company</field>
            <field name="model_id" ref="model_parcel_delivery_retry" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_sla_revision_company" model="ir.rule">
            <field name="name">Parcel SLA revisions by allowed company</field>
            <field name="model_id" ref="model_parcel_sla_revision" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_route_correction_company" model="ir.rule">
            <field name="name">Parcel route corrections by allowed company</field>
            <field name="model_id" ref="model_parcel_route_correction" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_courier_reassignment_company" model="ir.rule">
            <field name="name">Parcel courier reassignments by allowed company</field>
            <field name="model_id" ref="model_parcel_courier_reassignment" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_courier_company" model="ir.rule">
            <field name="name">Parcel couriers by allowed company</field>
            <field name="model_id" ref="model_parcel_courier" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_zone_company" model="ir.rule">
            <field name="name">Parcel zones by allowed company</field>
            <field name="model_id" ref="model_parcel_delivery_zone" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ptm_postcode_rule_company" model="ir.rule">
            <field name="name">Parcel postcode rules by allowed company</field>
            <field name="model_id" ref="model_parcel_zone_postcode_rule" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_ptm_operator_all_shipments" model="ir.rule">
            <field name="name">Operators access all allowed-company shipments</field>
            <field name="model_id" ref="model_parcel_shipment" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>
        <record id="rule_ptm_operator_all_packages" model="ir.rule">
            <field name="name">Operators access all allowed-company packages</field>
            <field name="model_id" ref="model_parcel_package" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>
        <record id="rule_ptm_operator_all_pickup_events" model="ir.rule">
            <field name="name">Operators access all allowed-company pickup events</field>
            <field name="model_id" ref="model_parcel_pickup_event" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>
        <record id="rule_ptm_operator_all_delivery_events" model="ir.rule">
            <field name="name">Operators access all allowed-company delivery events</field>
            <field name="model_id" ref="model_parcel_delivery_event" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>
        <record id="rule_ptm_operator_all_delivery_attempts" model="ir.rule">
            <field name="name">Operators access all allowed-company delivery attempts</field>
            <field name="model_id" ref="model_parcel_delivery_attempt" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>
        <record id="rule_ptm_operator_all_delivery_retries" model="ir.rule">
            <field name="name">Operators access all allowed-company delivery retries</field>
            <field name="model_id" ref="model_parcel_delivery_retry" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>
        <record id="rule_ptm_operator_all_sla_revisions" model="ir.rule">
            <field name="name">Operators access all allowed-company SLA revisions</field>
            <field name="model_id" ref="model_parcel_sla_revision" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>
        <record id="rule_ptm_operator_all_route_corrections" model="ir.rule">
            <field name="name">Operators access all allowed-company route corrections</field>
            <field name="model_id" ref="model_parcel_route_correction" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>
        <record id="rule_ptm_operator_all_couriers" model="ir.rule">
            <field name="name">Operators access all allowed-company couriers</field>
            <field name="model_id" ref="model_parcel_courier" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>
        <record id="rule_ptm_operator_all_courier_reassignments" model="ir.rule">
            <field name="name">Operators access all allowed-company courier reassignments</field>
            <field name="model_id" ref="model_parcel_courier_reassignment" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_operator'))]" />
        </record>

        <record id="rule_ptm_courier_own_shipments" model="ir.rule">
            <field name="name">Couriers access their own shipments</field>
            <field name="model_id" ref="model_parcel_shipment" />
            <field name="domain_force">[('courier_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
        <record id="rule_ptm_courier_own_packages" model="ir.rule">
            <field name="name">Couriers access packages from their shipments</field>
            <field name="model_id" ref="model_parcel_package" />
            <field name="domain_force">[('shipment_id.courier_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
        <record id="rule_ptm_courier_own_pickup_events" model="ir.rule">
            <field name="name">Couriers access pickup events from their shipments</field>
            <field name="model_id" ref="model_parcel_pickup_event" />
            <field name="domain_force">[('shipment_id.courier_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
        <record id="rule_ptm_courier_own_delivery_events" model="ir.rule">
            <field name="name">Couriers access delivery events from their shipments</field>
            <field name="model_id" ref="model_parcel_delivery_event" />
            <field name="domain_force">[('shipment_id.courier_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
        <record id="rule_ptm_courier_own_delivery_attempts" model="ir.rule">
            <field name="name">Couriers access their own delivery attempts</field>
            <field name="model_id" ref="model_parcel_delivery_attempt" />
            <field name="domain_force">[('courier_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
        <record id="rule_ptm_courier_own_delivery_retries" model="ir.rule">
            <field name="name">Couriers access retries involving them</field>
            <field name="model_id" ref="model_parcel_delivery_retry" />
            <field
                name="domain_force"
            >['|', ('previous_courier_id.user_id', '=', user.id), ('new_courier_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
        <record id="rule_ptm_courier_own_sla_revisions" model="ir.rule">
            <field name="name">Couriers access SLA revisions from their shipments</field>
            <field name="model_id" ref="model_parcel_sla_revision" />
            <field name="domain_force">[('shipment_id.courier_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
        <record id="rule_ptm_courier_own_route_corrections" model="ir.rule">
            <field name="name">Couriers access route corrections from their shipments</field>
            <field name="model_id" ref="model_parcel_route_correction" />
            <field name="domain_force">[('shipment_id.courier_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
        <record id="rule_ptm_courier_own_reassignments" model="ir.rule">
            <field name="name">Couriers access reassignments from their shipments</field>
            <field name="model_id" ref="model_parcel_courier_reassignment" />
            <field name="domain_force">[('shipment_id.courier_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
        <record id="rule_ptm_courier_own_profile" model="ir.rule">
            <field name="name">Couriers access their own courier profile</field>
            <field name="model_id" ref="model_parcel_courier" />
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ptm_courier'))]" />
        </record>
    </data>
</odoo>
